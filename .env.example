# --- Client-side (safe to expose, prefixed NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-side only (Vercel project env vars, never NEXT_PUBLIC_) ---
# Used by Next.js server components/route handlers, and set as Supabase Edge Function secrets too.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider for sequence generation (used by the generate-sequence Edge Function)
ANTHROPIC_API_KEY=

# Credential encryption key for integration_credentials.secret (32-byte, base64). Generate with:
#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Google OAuth (Gmail readonly) - from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the redirect URI registered with Google, pointing at your Supabase project's
# oauth-google function, e.g. https://<project-ref>.supabase.co/functions/v1/oauth-google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# Microsoft OAuth (Outlook readonly, Mail.Read) - from Azure AD app registration
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=

# Base URL of the deployed app, used for OAuth "return to app" redirects after Google/Microsoft consent
APP_URL=http://localhost:3000
